<included>
    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>

    <!-- Spring Profile 값을 읽어오기 -->
    <springProperty name="projectName" source="spring.application.name"/>
    <springProperty name="activeProfile" source="spring.profiles.active"/>

    <!-- 로그 파일이 저장될 경로 -->
    <property name="LOG_PATH" value="../${projectName}-log/${activeProfile}"/>

    <!-- 로그 파일 이름 -->
    <property name="LOG_FILE_NAME" value="${projectName}"/>

    <!-- 로그 출력 패턴 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [TraceId: %X{traceId}] %clr(%5level) %cyan(%logger{0}) - %msg%n"/>

    <!-- local 전용 컬러 콘솔 -->
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <Pattern>${CONSOLE_LOG_PATTERN}</Pattern>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="!local">
        <!-- File에 로그 출력 세팅 -->
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <!-- 파일 경로 설정 -->
            <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>

            <!-- 출력패턴 설정-->
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${projectName}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
            </encoder>

            <!-- Rolling 정책 -->
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <!-- .gz,.zip 등을 넣으면 자동 일자별 로그파일 압축 -->
                <fileNamePattern>${LOG_PATH}/%d{yyyy-MM, aux}/${LOG_FILE_NAME}.%d{yyyy-MM-dd}.log</fileNamePattern>
                <!-- 일자별 로그파일 최대 보관주기(~일), 해당 설정일 이상된 파일은 자동으로 제거-->
                <maxHistory>30</maxHistory>
                <!-- 로그 파일 최대 보관 크기. 최대 크기를 초과하면 가장 오래된 로그 자동 제거 -->
                <totalSizeCap>20GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${projectName}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
            </encoder>
        </appender>

        <!-- 비동기 래핑 (고부하 시 스레드 블로킹 방지) -->
        <appender name="ASYNC_JSON_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="JSON_CONSOLE"/>
            <queueSize>1024</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
        </appender>

        <appender name="ASYNC_JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="JSON_FILE"/>
            <queueSize>1024</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
        </appender>
    </springProfile>
</included>